#!/data/data/com.termux/files/usr/bin/bash
LOG=$HOME/rsc-server.log
termux-wake-lock
screen -wipe >/dev/null 2>&1
if ! screen -ls | grep -q '\.rsc[[:space:]]'; then
  : > "$LOG"
  screen -L -Logfile "$LOG" -dmS rsc proot-distro login ubuntu --bind $HOME/Core-Framework:/root/Core-Framework -- bash -c "cd /root/Core-Framework/server && ant runserver -DconfFile=local"
  screen -dmS rscwatch $HOME/rsc-watch.sh
  for i in $(seq 1 120); do
    grep -q "now online on TCP" "$LOG" && break
    sleep 1
  done
fi
am start -n com.openrsc.client/com.openrsc.android.updater.ApplicationUpdater
